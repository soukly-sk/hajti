{
  "name": "hajti-app",
  "version": "1.0.0",
  "private": true,
  "description": "HAJTI online marketplace for Android, Windows and macOS",
  "main": "electron/main.cjs",
  "scripts": {
    "build:web": "node scripts/copy-web.mjs",
    "build:android": "npm run build:web && cap sync android",
    "build:windows": "npm run build:web && electron-builder --win nsis --publish never",
    "build:mac:legacy": "npm run build:web && electron-builder --mac dmg zip --x64 --publish never"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ma.hajti.store",
    "productName": "HAJTI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "www/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
